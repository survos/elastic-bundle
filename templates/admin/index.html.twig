{# Prefer the app's own base; fall back to Tabler's when the bundle is used standalone. #}
{% extends ['base.html.twig', '@SurvosTabler/layout/base.html.twig'] %}

{% block title %}Elasticsearch Indexes{% endblock %}

{% block body %}
    <div class="container-xl py-3">
        <div class="page-header d-print-none mb-3">
            <h2 class="page-title">Elasticsearch Indexes</h2>
            <div class="text-secondary mt-1">
                Read live from Elasticsearch — nothing here is stored or synced.
            </div>
        </div>

        {% if reports is empty %}
            <div class="alert alert-info">
                No Elasticsearch-backed searches are registered.
            </div>
        {% else %}
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Search</th>
                                <th>Entity</th>
                                <th>Source</th>
                                <th>Index</th>
                                <th class="text-end">Documents</th>
                                <th class="text-end">Fields</th>
                                <th>Aliases</th>
                                <th>Schema</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for report in reports %}
                                <tr>
                                    <td>
                                        <a href="{{ path('survos_elastic_admin_show', {code: report.code}) }}">{{ report.code }}</a>
                                    </td>
                                    <td class="text-secondary">{{ report.shortClass ?? '—' }}</td>
                                    <td>
                                        {# Doctrine is a fallback, not a decision — and the one that stops
                                           holding for folio, where rows never come from the ORM. #}
                                        {% if report.documentSource == 'provider' %}
                                            <span class="badge bg-blue-lt" title="A documentProvider is configured">provider</span>
                                        {% elseif report.documentSource == 'doctrine' %}
                                            <span class="badge bg-secondary-lt" title="No documentProvider — falls back to iterating the entity through Doctrine">doctrine</span>
                                        {% else %}
                                            <span class="text-secondary">—</span>
                                        {% endif %}
                                    </td>
                                    <td><code>{{ report.index }}</code></td>
                                    <td class="text-end">
                                        {% if report.exists %}
                                            {{ report.documentCount|number_format }}
                                        {% else %}
                                            <span class="badge bg-secondary-lt">not created</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">{{ report.actualFields|length }}</td>
                                    <td>
                                        {% if report.aliases is not empty %}
                                            {% for alias in report.aliases %}<code>{{ alias }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
                                        {% else %}
                                            <span class="text-secondary">none</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if report.warningCount > 0 %}
                                            <span class="badge bg-yellow-lt">{{ report.warningCount }} to review</span>
                                        {% elseif report.exists %}
                                            <span class="badge bg-green-lt">clean</span>
                                        {% else %}
                                            <span class="badge bg-secondary-lt">—</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <p class="text-secondary mt-3">
                Document browsing, raw queries, shards and snapshots live in Elasticvue and Kibana —
                see the Elastic menu. These pages only cover what those tools cannot know: whether the
                index matches what this application declared.
            </p>
        {% endif %}

        {# The registry only knows what this app declared. The cluster namespace is flat and shared,
           so anything here without a search is an index nobody is claiming — usually a rename that
           left the old name behind, or a locale variant. #}
        {% set unclaimed = clusterIndices|filter(row => row.searchCode is null) %}

        {% if unprefixedCount > 0 %}
            <div class="alert alert-warning mt-3">
                Nothing on the cluster matches <code>{{ indexPattern }}</code>, but it holds
                <strong>{{ unprefixedCount }}</strong> unprefixed {{ unprefixedCount == 1 ? 'index' : 'indices' }}.
                Those predate <code>survos_search.index_prefix</code> and are now outside this app's namespace —
                recreate and repopulate under the new names
                (<code>bin/console elastic:index:create</code>, then <code>elastic:index:populate</code>),
                then delete the old ones.
            </div>
        {% endif %}

        {% if clusterIndices is not empty %}
            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title">On the cluster</h3>
                    <div class="card-actions text-secondary">
                        pattern <code>{{ indexPattern }}</code>
                        {% if unclaimed is not empty %}
                            · <span class="badge bg-yellow-lt">{{ unclaimed|length }} not declared here</span>
                        {% endif %}
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Index</th>
                                <th>Declared by</th>
                                <th class="text-end">Documents</th>
                                <th class="text-end">Size</th>
                                <th>Health</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in clusterIndices %}
                                <tr>
                                    <td><code>{{ row.index }}</code></td>
                                    <td>
                                        {% if row.searchCode %}
                                            <a href="{{ path('survos_elastic_admin_show', {code: row.searchCode}) }}">{{ row.searchCode }}</a>
                                        {% else %}
                                            <span class="badge bg-yellow-lt" title="No search in this app declares this index">not declared here</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">{{ row.docs|number_format }}</td>
                                    <td class="text-end text-secondary">{{ row.size ?? '—' }}</td>
                                    <td>
                                        <span class="badge bg-{{ row.health == 'green' ? 'green' : (row.health == 'yellow' ? 'yellow' : 'secondary') }}-lt">{{ row.health ?? '?' }}</span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-secondary">
                    Every app pointed at this node shares one flat index namespace, so indices from other
                    applications appear here too. Narrow the list with <code>survos_elastic.index_pattern</code>
                    (e.g. <code>kpa-*</code>). System indices are always hidden.
                    {% if unclaimed is not empty %}
                        A yellow row is <em>not</em> automatically stale — it may belong to another app.
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
